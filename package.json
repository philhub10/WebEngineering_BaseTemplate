{
  "name": "webengineering-baseplayground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:*\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build --workspaces",
    "lint": "npm run lint -ws --if-present",
    "lint:fix": "npm run lint:fix -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "test": "npm run test -ws --if-present",
    "db:generate": "npm run db:generate -w apps/api --",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "format": "prettier --write \"apps/*/{src,test}/**/*.{ts,html,css}\"",
    "format:check": "prettier --check \"apps/*/{src,test}/**/*.{ts,html,css}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/*/{src,test}/**/*.{ts,html}": [
      "eslint --fix",
      "prettier --write"
    ],
    "apps/*/src/**/*.css": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.11.0",
    "eslint-config-love": "^157.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "typescript-eslint": "^8.69.0"
  }
}
