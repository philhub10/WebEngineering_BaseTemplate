# Copy to .env (gitignored, never commit it) and replace the placeholders:
#   cp .env.example .env
# Generate a secret with: openssl rand -hex 32

POSTGRES_PASSWORD=changeme

DATABASE_URL=postgres://bears:changeme@localhost:5432/bears

# Signs the session cookie, at least 32 characters.
SESSION_SECRET=change-me-to-at-least-32-random-characters

# Optional: password of moderator@bears.example, at least 12 characters.
# Empty: the seed generates one and prints it once.
SEED_MODERATOR_PASSWORD=
